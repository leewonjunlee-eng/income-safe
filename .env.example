# Vercel 프로젝트 Settings > Environment Variables 에 아래 이름 그대로 넣으면 됩니다. (로컬은 .env.local)
# 값은 서버 함수에서만 읽고, 브라우저로는 내보내지 않습니다.

# ①-1 서류 자동 입력 (Google AI Studio 키)
GEMINI_API_KEY=
# GEMINI_MODEL=   (비우면 gemini-3.1-flash-lite → 3.5-flash → flash-latest 순으로 시도. 고정하려면 모델명 지정)

# ⓪-2b 시장 데이터 자동 갱신
ECOS_API_KEY=        # 한국은행 ECOS
KOSIS_API_KEY=       # KOSIS 국가통계포털
DATA_GO_KR_KEY=      # 공공데이터포털 (금융위원회 지수시세정보)

# 선택: 통계 코드를 바꿔야 할 때만 (기본값은 아래와 같음)
# ECOS_POLICY_STAT=722Y001   ECOS_POLICY_ITEM=0101000    (기준금리)
# ECOS_DEPOSIT_STAT=121Y002  ECOS_DEPOSIT_ITEM=BEABAA2   (예금은행 저축성수신 신규취급액 가중평균)
# ECOS_LOAN_STAT=121Y006     ECOS_LOAN_ITEM=BECBLA03     (가계대출 신규취급액 가중평균)
# KOSIS_ORG_ID=101  KOSIS_TBL_ID=DT_1J22003  KOSIS_ITM_ID=T  KOSIS_OBJ_L1=T10   (소비자물가)
# KOSIS_IS_RATE=1   (위 항목이 지수가 아니라 전년동월 등락률일 때)
